# Copy to .env and change the secrets before running `docker compose up`.

# Database password (used by both the db and api containers).
POSTGRES_PASSWORD=change-me-db-password

# Signs login sessions — use a long random value, e.g. `openssl rand -hex 32`.
SESSION_SECRET=replace-with-at-least-32-random-characters-0000

# true: header role switcher + "Reset demo data" are enabled. Set false for real use.
DEMO_MODE=true

# "Continue as guest" on the sign-in page: read-only, prices and credit hidden.
# Leave empty to follow DEMO_MODE; set false to require everyone to sign in.
ALLOW_GUEST=

# Password every seeded user gets on first start (sign in as e.g. "somchai" / this password).
DEMO_PASSWORD=demo1234

# With the HTTPS profile (Caddy in front of nginx) set this to 2.
# TRUST_PROXY_HOPS=1

# Outgoing email for sending documents. Leave unset to catch everything in the local Mailpit mailbox
# (http://localhost:8025). For real email set all of these, and MAIL_CATCHALL_URL= (empty).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=erp@example.com
# SMTP_PASS=
# SMTP_FROM=Your Company <erp@example.com>
# MAIL_CATCHALL_URL=

# Where people open the app — the links in emails point here.
APP_URL=http://localhost:8080

# Hour (Bangkok time) the morning summary email goes out to people who turned it on under "My account".
DIGEST_HOUR=7

# Roles that must use two-step sign-in (authenticator app codes), comma-separated, e.g.
# seniorManager,supervisor. They're asked to set it up at their next sign-in. Empty = optional for everyone.
REQUIRE_TWO_FACTOR_ROLES=

# Set true when the site is served over HTTPS.
SECURE_COOKIES=false

# Port the web app is published on.
WEB_PORT=8080

# Port the API is reachable on from this machine (used by `npm run dev`).
API_PORT=3000

# Backups (written to ./backups): how often, and how long to keep them.
BACKUP_EVERY_HOURS=24
BACKUP_KEEP_DAYS=14

# HTTPS on a real domain (docker compose --profile https up -d). Also set SECURE_COOKIES=true.
DOMAIN=
